# Paperless-ngx's address on the compose network: its service name, port 8000.
PAPERLESS_URL=http://webserver:8000

# Optional: enable OAuth login. Leave both empty for API tokens only.
# Public HTTPS address of this server, behind your reverse proxy.
MCP_BASE_URL=
# Encrypts stored logins. Generate once with: openssl rand -hex 32
MCP_OAUTH_SECRET=

# Optional: which toolsets become tools (comma-separated, or "all").
# Empty uses the defaults: documents and their metadata, no administration.
MCP_TOOLSETS=

# Optional: accept only these Host headers, comma-separated host[:port].
MCP_ALLOWED_HOSTS=
