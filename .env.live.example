# Settings for docker-compose.live.yaml. Copy to .env.live (gitignored) and run:
#   docker compose --env-file .env.live -f docker-compose.live.yaml up -d --build

# The real Paperless-ngx to develop against. Its OpenAPI spec is downloaded from
# <PAPERLESS_URL>/api/schema/ when the container starts.
PAPERLESS_URL=https://paperless.example.com

# Optional: an API token of that instance, for scripts such as
# dev/live-smoke.py. The MCP server itself never reads it -- clients send their
# own token, or log in through OAuth.
PAPERLESS_TOKEN=
